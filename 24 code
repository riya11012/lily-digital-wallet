interface NewUser {
  firstName: string
  lastName: string
  email: string
  role: string
  clinicalTrial: string
}

interface FormErrors {
  [key: string]: string
}

interface SearchUser {
  id: string
  firstName: string
  lastName: string
  email: string
  status: string
  role: string
  startDate: string
  endDate: string
  trial: string
}

export default function AddUserPage() {
  const [newUser, setNewUser] = useState<NewUser>({
    firstName: '',
    lastName: '',
    email: '',
    role: '',
    clinicalTrial: ''
  })
  const [formErrors, setFormErrors] = useState<FormErrors>({})
  const [isSubmitting, setIsSubmitting] = useState<boolean>(false)
  const [availableTrials, setAvailableTrials] = useState<string[]>([
    'Clinical Trial 1',
    'Clinical Trial 2'
  ])
  const [selectedTrials, setSelectedTrials] = useState<string[]>([''])
  const [userSearch, setUserSearch] = useState<string>('')
  const [searchResults, setSearchResults] = useState<SearchUser[]>([])
  const [showSearchResults, setShowSearchResults] = useState<boolean>(false)
  const [showSuccessModal, setShowSuccessModal] = useState<boolean>(false)
  const [submittedUser, setSubmittedUser] = useState<NewUser | null>(null)
  const router = useRouter()

  const isRoleAdminLike = (role: string) => role === 'Admin' || role === 'Superadmin'

  // Function to get clinical trial users
  const getClinicalTrialUsers = (): SearchUser[] => {
    return clinicalTrialUsers
  }

  const validateForm = () => {
    const errors: FormErrors = {}
    
    if (!newUser.firstName.trim()) {
      errors.firstName = 'First name is required'
    }
    
    if (!newUser.lastName.trim()) {
      errors.lastName = 'Last name is required'
    }
    
    if (!newUser.email.trim()) {
      errors.email = 'Email is required'
    } else if (!/\S+@\S+\.\S+/.test(newUser.email)) {
      errors.email = 'Email is invalid'
    }
    
    if (!newUser.role) {
      errors.role = 'Role is required'
    }
    
    // Clinical trials are required only for non-admin roles
    if (!isRoleAdminLike(newUser.role)) {
      if (!selectedTrials.some(trial => trial.trim())) {
        errors.clinicalTrial = 'At least one clinical trial is required'
      }
    }
    
    setFormErrors(errors)
    return Object.keys(errors).length === 0
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    
    console.log('=== FORM SUBMISSION DEBUG ===')
    console.log('Form submitted with data:', newUser)
    console.log('Selected trials:', selectedTrials)
    console.log('Form errors before validation:', formErrors)
    
    const isValid = validateForm()
    console.log('Form is valid:', isValid)
    console.log('Form errors after validation:', formErrors)
    
    if (!isValid) {
      console.log('Form validation failed, stopping submission')
      return
    }

    console.log('Starting form submission...')
    setIsSubmitting(true)
    
    try {
      // Simulate API call
      console.log('Simulating API call...')
      await new Promise(resolve => setTimeout(resolve, 1000))
      
      const userWithTrials = {
        ...newUser,
        clinicalTrials: selectedTrials.filter(trial => trial.trim())
      }
      
      console.log('Successfully added new user:', userWithTrials)
      
      // Store submitted user data and show success modal
      setSubmittedUser({
        ...newUser,
        clinicalTrial: selectedTrials.filter(trial => trial.trim()).join(', ')
      })
      setShowSuccessModal(true)
      
      // Reset form
      setNewUser({
        firstName: '',
        lastName: '',
        email: '',
        role: '',
        clinicalTrial: ''
      })
      setSelectedTrials([''])
      console.log('Form reset completed')
    } catch (error) {
      console.error('Error adding user:', error)
    } finally {
      setIsSubmitting(false)
      console.log('Form submission completed')
    }
  }

  const handleTrialChange = (index: number, value: string) => {
    const newTrials = [...selectedTrials]
    newTrials[index] = value
    setSelectedTrials(newTrials)
    
    // Update the main form data with the first trial
    if (index === 0) {
      setNewUser({...newUser, clinicalTrial: value})
    }
  }

  const handleAddTrial = () => {
    if (selectedTrials.length < 5) { // Limit to 5 trials
      setSelectedTrials([...selectedTrials, ''])
    }
  }

  const handleRemoveTrial = (index: number) => {
    if (selectedTrials.length > 1) {
      const newTrials = selectedTrials.filter((_, i) => i !== index)
      setSelectedTrials(newTrials)
      
      // Update main form data if we removed the first trial
      if (index === 0 && newTrials.length > 0) {
        setNewUser({...newUser, clinicalTrial: newTrials[0]})
      } else if (newTrials.length === 0) {
        setNewUser({...newUser, clinicalTrial: ''})
      }
    }
  }

  // Search functionality
  const handleSearchChange = (value: string) => {
    setUserSearch(value)
    
    if (value.trim().length > 0) {
      const allUsers = getClinicalTrialUsers()
      const filtered = allUsers.filter(user => 
        user.firstName.toLowerCase().includes(value.toLowerCase()) ||
        user.lastName.toLowerCase().includes(value.toLowerCase()) ||
        user.email.toLowerCase().includes(value.toLowerCase()) ||
        user.trial.toLowerCase().includes(value.toLowerCase()) ||
        user.role.toLowerCase().includes(value.toLowerCase()) ||
        user.status.toLowerCase().includes(value.toLowerCase())
      )
      setSearchResults(filtered)
      setShowSearchResults(true)
    } else {
      setSearchResults([])
      setShowSearchResults(false)
    }
  }

  // Handle user selection from search results
  const handleUserSelect = (user: SearchUser) => {
    setNewUser({
      firstName: user.firstName,
      lastName: user.lastName,
      email: user.email,
      role: user.role,
      clinicalTrial: user.trial
    })
    
    // Set the selected trial
    setSelectedTrials([user.trial])
    
    setUserSearch('')
    setSearchResults([])
    setShowSearchResults(false)
  }

  // Close search results when clicking outside
  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      const target = event.target as HTMLElement
      if (!target.closest('.search-container')) {
        setShowSearchResults(false)
      }
    }

    document.addEventListener('mousedown', handleClickOutside)
    return () => {
      document.removeEventListener('mousedown', handleClickOutside)
    }
  }, [])

  return (
    <div className="min-h-screen bg-gray-100 flex items-center justify-center p-2">
      <div className="bg-white rounded-2xl shadow-xl w-full max-w-lg">
        {/* Header */}
        <div className="flex items-center justify-between p-4">
          <h1 className="text-lg font-semibold text-gray-900">Add User</h1>
          <button
            onClick={() => router.push('/usersPage')}
            className="p-2 hover:bg-gray-100 rounded-full transition-colors"
          >
            <X className="h-5 w-5 text-gray-600" />
          </button>
        </div>

        {/* Form */}
        <form onSubmit={handleSubmit} className="p-4 space-y-4">
          {/* User Lookup Section */}
          <div className="space-y-3">
            <div className="relative search-container">
              <input
                type="text"
                value={userSearch}
                onChange={(e) => handleSearchChange(e.target.value)}
                placeholder="Search name, email"
                className="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
              />
              <Search className="absolute right-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-400" />
              
              {/* Search Results Dropdown */}
              {showSearchResults && searchResults.length > 0 && (
                <div className="absolute top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg z-10 max-h-60 overflow-y-auto">
                  {searchResults.map((user) => (
                    <div
                      key={user.id}
                      onClick={() => handleUserSelect(user)}
                      className="px-3 py-2 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-b-0"
                    >
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="font-medium text-sm text-gray-900">
                            {user.firstName} {user.lastName}
                          </div>
                          <div className="text-xs text-gray-500">
                            {user.email} • {user.trial}
                          </div>
                        </div>
                        <div className="text-xs text-gray-400">
                          <span className={`px-2 py-1 rounded-full text-xs ${
                            user.status === 'Active' ? 'bg-green-100 text-green-800' :
                            'bg-red-100 text-red-800'
                          }`}>
                            {user.status}
                          </span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
              
              {/* No Results Message */}
              {showSearchResults && searchResults.length === 0 && userSearch.trim().length > 0 && (
                <div className="absolute top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg z-10">
                  <div className="px-3 py-2 text-sm text-gray-500 text-center">
                    No users found
                  </div>
                </div>
              )}
            </div>
            
            <div className="relative">
              <div className="absolute inset-0 flex items-center">
                <div className="w-full border-t border-gray-200" />
              </div>
              <div className="relative flex justify-center text-sm">
                <span className="px-4 bg-white text-gray-500">or</span>
              </div>
            </div>
          </div>

          {/* Form Fields */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {/* First Name */}
           
           <div>
  <label className="block text-xs font-medium text-gray-900 mb-1">
    First Name
  </label>
  <input
    type="text"
    value={newUser.firstName}
    onChange={(e) => {
      setNewUser({ ...newUser, firstName: e.target.value })
      if (formErrors.firstName) setFormErrors({ ...formErrors, firstName: '' })
    }}
    className={`w-full px-3 py-2 bg-white border ${
      formErrors.firstName ? 'border-red-600' : 'border-gray-300'
    } rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-sm`}
    placeholder="Enter first name"
  />
  {formErrors.firstName && (
    <p className="text-xs text-red-600 mt-1">{formErrors.firstName}</p>
  )}
</div>


            {/* Last Name */}
            <div>
              <label className="block text-xs font-medium text-gray-900 mb-1">
                Last Name
              </label>
              <input
                type="text"
                value={newUser.lastName}
                onChange={(e) => {
                  setNewUser({...newUser, lastName: e.target.value})
                  if (formErrors.lastName) {
                    setFormErrors({...formErrors, lastName: ''})
                  }
                }}
                className={`w-full px-3 py-2 bg-gray-50 border ${
                  formErrors.lastName ? 'border-red-500' : 'border-gray-200'
                } rounded-t-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm`}
                placeholder=""
              />
              {formErrors.lastName && (
                <div className="-mt-px w-full bg-red-600 text-white text-sm rounded-b-lg px-3 py-2">
                  Enter last name
                </div>
              )}
            </div>

            {/* Email */}
            <div>
              <label className="block text-xs font-medium text-gray-900 mb-1">
                Email
              </label>
              <input
                type="email"
                value={newUser.email}
                onChange={(e) => {
                  setNewUser({...newUser, email: e.target.value})
                  if (formErrors.email) {
                    setFormErrors({...formErrors, email: ''})
                  }
                }}
                className={`w-full px-3 py-2 bg-gray-50 border ${
                  formErrors.email ? 'border-red-500' : 'border-gray-200'
                } rounded-t-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm`}
                placeholder=""
              />
              {formErrors.email && (
                <div className="-mt-px w-full bg-red-600 text-white text-sm rounded-b-lg px-3 py-2">
                  Enter email
                </div>
              )}
            </div>

            {/* Role */}
            <div>
              <label className="block text-xs font-medium text-gray-900 mb-1">
                Role
              </label>
              <div className="relative">
                <select
                  value={newUser.role}
                  onChange={(e) => {
                    console.log('Role changed to:', e.target.value)
                    const role = e.target.value
                    setNewUser({...newUser, role})
                    // If admin or superadmin, clear clinical trials selections and related errors
                    if (role === 'Admin' || role === 'Superadmin') {
                      setSelectedTrials([''])
                      if (formErrors.clinicalTrial) {
                        setFormErrors({...formErrors, clinicalTrial: ''})
                      }
                    }
                    if (formErrors.role) {
                      setFormErrors({...formErrors, role: ''})
                    }
                  }}
                  className={`w-full px-3 py-2 bg-gray-50 border ${
                    formErrors.role ? 'border-red-500' : 'border-gray-200'
                  } rounded-t-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent appearance-none text-sm`}
                >
                  <option value="">Select</option>
                  <option value="Study Coord.">Study Coordinator</option>
                  <option value="Site Coord.">Site Coordinator</option>
                  <option value="Admin">Admin</option>
                  <option value="Superadmin">Superadmin</option>
                </select>
                <ChevronDown className="absolute right-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-gray-400 pointer-events-none" />
              </div>
              {formErrors.role && (
                <div className="-mt-px w-full bg-red-600 text-white text-sm rounded-b-lg px-3 py-2">
                  Select role
                </div>
              )}
            </div>

            {/* Clinical Trials */}
            {!isRoleAdminLike(newUser.role) && (
            <div className="md:col-span-2">
              <label className="block text-xs font-medium text-gray-900 mb-1">
                Clinical Trials
              </label>
              <div className="space-y-2">
                {selectedTrials.map((trial, index) => (
                  <div key={index} className="flex items-center gap-2">
                   
                    <div className="w-1/2">
                      <select
                        value={trial}
                        onChange={(e) => handleTrialChange(index, e.target.value)}
                        className={`w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm ${
                          formErrors.clinicalTrial ? 'border-red-500' : ''
                        }`}
                      >
                        <option value="">Select trial</option>
                        {availableTrials.map((availableTrial) => (
                          <option key={availableTrial} value={availableTrial}>
                            {availableTrial}
                          </option>
                        ))}
                      </select>
                    </div>
                    {selectedTrials.length > 1 && (
                      <button
                        type="button"
                        onClick={() => handleRemoveTrial(index)}
                        className="text-gray-400 hover:text-red-500 p-1"
                      >
                        🗑
                      </button>
                    )}
                  </div>
                ))}
                {/* Clinical trial error above Add trial */}
                {formErrors.clinicalTrial && (
                  <div className="mt-2 w-1/2 rounded-lg border border-red-300 bg-white shadow-sm">
                    <div className="flex items-center gap-3 px-4 py-3 text-gray-800">
                      <span className="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-100 text-red-600 text-sm font-semibold">!</span>
                      <span className="text-sm">Select a clinical trial</span>
                    </div>
                  </div>
                )}

                {selectedTrials.length < 5 && (
                  <button
                    type="button"
                    onClick={handleAddTrial}
                    className="w-1/2 mt-2 border border-gray-300 rounded-full px-4 py-1 text-gray-400 flex items-center justify-between hover:bg-gray-50"
                    aria-label="Add trial"
                  >
                    <span className="mx-auto">Add trial</span>
                    <span className="ml-2 inline-flex items-center justify-center w-7 h-5 rounded-full border border-gray-300 text-gray-400">
                      <Plus className="w-4 h-4" />
                    </span>
                  </button>
                )}
              </div>
            </div>
            )}
          </div>

          {/* Submit Button */}
          <div className="flex justify-end pt-6 gap-4">
         
              
         
            <button
              type="submit"
              disabled={isSubmitting}
              className="flex items-center space-x-2 px-6 py-3 bg-red-600 text-white rounded-xl hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            >
              <span>Submit</span>
              <svg className="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </form>
      </div>

      {/* Success Modal */}
      {showSuccessModal && submittedUser && (
        <div className="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4">
            {/* Modal Header */}
            <div className="flex items-center justify-between p-4 border-b border-gray-200">
              <h2 className="text-lg font-semibold text-gray-900">Add User</h2>
              <button
                onClick={() => setShowSuccessModal(false)}
                className="p-2 hover:bg-gray-100 rounded-full transition-colors"
              >
                <X className="h-5 w-5 text-gray-600" />
              </button>
            </div>

            {/* Success Content */}
            <div className="p-6">
              {/* Success Message */}
              <div className="text-center mb-6">
                <div className="flex items-center justify-center mb-3">
                  <div className="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                    <svg className="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </div>
                <h3 className="text-lg font-medium text-gray-900">User has been added</h3>
              </div>

              {/* Divider */}
              <div className="border-t border-gray-200 mb-6"></div>

              {/* User Details */}
              <div className="grid grid-cols-2 gap-4 mb-6">
                {/* Left Column - User Info */}
                <div>
                  <div className="font-semibold text-gray-900 text-sm mb-1">
                    {submittedUser.firstName} {submittedUser.lastName}
                  </div>
                  <div className="text-xs text-gray-600">
                    {submittedUser.email}
                  </div>
                </div>

                {/* Right Column - Role and Trials */}
                <div>
                  <div className="font-semibold text-gray-900 text-sm mb-1">
                    {submittedUser.role}
                  </div>
                  <div className="text-xs text-gray-600 space-y-1">
                    {submittedUser.clinicalTrial.split(', ').map((trial, index) => (
                      <div key={index}>{trial}</div>
                    ))}
                  </div>
                </div>
              </div>

              {/* Close Button */}
              <div className="flex justify-end">
                <button
                  onClick={() => setShowSuccessModal(false)}
                  className="flex items-center space-x-2 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
                >
                  <span>Close</span>
                  <X className="h-4 w-4" />
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
