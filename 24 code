  id: string
  firstName: string
  lastName: string
  email: string
  role: string
  clinicalTrial: string
  status: 'Active' | 'Inactive'
  startDate: string
  endDate: string
}

interface FormErrors {
  [key: string]: string
}

// Mock data for existing site coordinators (matching site-coordinators page data)
const existingSiteCoordinators: SiteCoordinator[] = [
  {
    id: '1',
    firstName: 'Audra',
    lastName: 'Luettgen',
    email: 'Audra.Luettgen@domain.ext',
    role: 'Site Coord.',
    clinicalTrial: 'Clinical Trial 1',
