                {
                    logWriter.WriteLine($"{DateTime.Now}: {ex.Message}");
                    logWriter.WriteLine(ex.StackTrace);
                    logWriter.WriteLine("------------------------------------------------");
                }
            }
            catch { }
        }
    }
