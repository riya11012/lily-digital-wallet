'use client'

import { useState, useEffect } from 'react'
import { useRouter } from 'next/navigation'
import { Search, Plus, ChevronDown, MoreVertical, X, Trash2, AlertCircle } from 'lucide-react'
import DatePicker from 'react-datepicker'
import 'react-datepicker/dist/react-datepicker.css'

interface SiteCoordinator {
  id: string
  firstName: string
  lastName: string
  email: string
  status: 'Active' | 'Inactive'
  role: string
  startDate: string
  endDate?: string
}

export default function SiteCoordinatorsPage() {
  const router = useRouter()
  
  const sampleCoordinators: SiteCoordinator[] = [
    { id: '1', firstName: 'Audra', lastName: 'Luettgen', email: 'Audra.Luettgen@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '15/01/2024', endDate: '15/12/2024' },
    { id: '2', firstName: 'Augustus', lastName: 'Daugherty', email: 'Augustus.Daugherty@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '20/02/2024', endDate: '20/11/2024' },
    { id: '3', firstName: 'Dessie', lastName: 'Grady', email: 'Dessie.Grady@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '10/03/2024', endDate: '10/10/2024' },
    { id: '4', firstName: 'Selina', lastName: 'Abernathy', email: 'Selina.Abernathy@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '05/04/2024', endDate: '05/09/2024' },
    { id: '5', firstName: 'Lyda', lastName: 'Gulgowski', email: 'Lyda.Gulgowski@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '12/05/2024', endDate: '12/08/2024' },
    { id: '6', firstName: 'Lola', lastName: 'Rutherford', email: 'Lola.Rutherford@domain.ext', status: 'Inactive', role: 'Site Coord.', startDate: '01/06/2024', endDate: '01/07/2024' }
  ]

  const [search, setSearch] = useState('')
  const [trialFilter, setTrialFilter] = useState('')
  const [statusFilter, setStatusFilter] = useState('')
  const [fromDate, setFromDate] = useState<Date | null>(null)
  const [toDate, setToDate] = useState<Date | null>(null)
  const [expandedTrials, setExpandedTrials] = useState<Record<string, boolean>>({ 'Clinical Trial 1': true })
  const [showDropdown, setShowDropdown] = useState<string | null>(null)
  const [showDeleteModal, setShowDeleteModal] = useState<boolean>(false)
  const [coordinatorToDelete, setCoordinatorToDelete] = useState<SiteCoordinator | null>(null)
  const [showRemoveModal, setShowRemoveModal] = useState<boolean>(false)
  const [coordinatorToRemove, setCoordinatorToRemove] = useState<SiteCoordinator | null>(null)
  const [showRemoveSuccessModal, setShowRemoveSuccessModal] = useState<boolean>(false)
  const [removedCoordinator, setRemovedCoordinator] = useState<SiteCoordinator | null>(null)
  const [coordinators, setCoordinators] = useState<SiteCoordinator[]>(sampleCoordinators)

  const trials = [
    { name: 'Clinical Trial 1', count: 50 },
    { name: 'Clinical Trial 2', count: 20 }
  ]

  const filteredCoordinators = coordinators.filter(coordinator => {
    if (search && !coordinator.firstName.toLowerCase().includes(search.toLowerCase()) &&
        !coordinator.lastName.toLowerCase().includes(search.toLowerCase()) &&
        !coordinator.email.toLowerCase().includes(search.toLowerCase())) {
      return false
    }

    if (statusFilter && coordinator.status.toLowerCase() !== statusFilter.toLowerCase()) {
      return false
    }

    if (fromDate || toDate) {
      const coordinatorStartDate = parseDate(coordinator.startDate)
      if (!coordinatorStartDate) return false
      if (fromDate && coordinatorStartDate < fromDate) return false
      if (toDate && coordinatorStartDate > toDate) return false
    }

    return true
  })

  function parseDate(dateStr: string): Date | null {
    if (!dateStr) return null
    const [day, month, year] = dateStr.split('/').map(Number)
    return new Date(year, month - 1, day)
  }

  const toggleTrial = (trialName: string) => {
    setExpandedTrials(prev => ({
      ...prev,
      [trialName]: !prev[trialName]
    }))
  }

  const getStatusDot = (status: string) => (
    <div className={`w-2 h-2 rounded-full ${status === 'Active' ? 'bg-green-500' : 'bg-red-500'}`}></div>
  )

  const handleCoordinatorAction = (coordinator: SiteCoordinator, event: React.MouseEvent) => {
    event.stopPropagation()
    setShowDropdown(showDropdown === coordinator.id ? null : coordinator.id)
  }

  const handleAddCoordinator = () => {
    console.log('Add Coordinator button clicked, navigating to /add-site-coordinator')
    router.push('/add-site-coordinator')
  }

  const handleEditCoordinator = (coordinator: SiteCoordinator) => {
    console.log('Edit Coordinator button clicked, navigating to /add-site-coordinator?edit=' + coordinator.id)
    router.push(`/add-site-coordinator?edit=${coordinator.id}`)
    setShowDropdown(null)
  }

  const closeDropdown = () => setShowDropdown(null)

  const handleDeleteCoordinator = (coordinator: SiteCoordinator) => {
    setCoordinatorToDelete(coordinator)
    setShowDeleteModal(true)
    setShowDropdown(null)
  }

  const confirmDeleteCoordinator = () => {
    if (coordinatorToDelete) {
      setCoordinators(coordinators.filter(coordinator => coordinator.id !== coordinatorToDelete.id))
      setShowDeleteModal(false)
      setCoordinatorToDelete(null)
    }
  }

  const cancelDeleteCoordinator = () => {
    setShowDeleteModal(false)
    setCoordinatorToDelete(null)
  }

  const handleRemoveFromTrial = (coordinator: SiteCoordinator) => {
    setCoordinatorToRemove(coordinator)
    setShowRemoveModal(true)
    setShowDropdown(null)
  }

  const confirmRemoveFromTrial = () => {
    if (coordinatorToRemove) {
      // Remove coordinator from the current trial (Clinical Trial 1)
      // In a real app, this would make an API call to remove coordinator from trial
      console.log(`Removed ${coordinatorToRemove.firstName} ${coordinatorToRemove.lastName} from trial`)
      
      // Store the removed coordinator data for success modal
      setRemovedCoordinator(coordinatorToRemove)
      
      // Close the confirmation modal
      setShowRemoveModal(false)
      setCoordinatorToRemove(null)
      
      // Show success modal
      setShowRemoveSuccessModal(true)
    }
  }

  const cancelRemoveFromTrial = () => {
    setShowRemoveModal(false)
    setCoordinatorToRemove(null)
  }

  const closeRemoveSuccessModal = () => {
    setShowRemoveSuccessModal(false)
    setRemovedCoordinator(null)
  }

  return (
    <div className="min-h-screen bg-white py-4">
      <div className="max-w-5xl mx-auto px-4 mt-8">
        <div className="bg-white rounded-2xl shadow-sm">
          {/* Header */}
          <div className="px-4 py-3 border-b bg-gray-100 border-gray-200 rounded-t-2xl flex justify-between items-center">
            <h1 className="text-lg text-gray-900 ">Manage Site Coordinators</h1>
            <div className="flex items-center space-x-3">
              <div className="relative">
                <input
                  type="text"
                  placeholder="Search"
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  className="w-70 pl-8 pr-20 py-1.5 border border-gray-300 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <Search className="absolute left-2 top-1/2 transform -translate-y-1/2 h-3 w-3 text-gray-400" />
              </div>
              <button
                onClick={handleAddCoordinator}
                className="bg-[#007fb2] text-white px-3 py-2 rounded-3xl text-sm font-medium flex items-center space-x-1 hover:bg-blue-700"
              >
                <Plus className="h-3 w-3" />
                <span>Add User</span>
              </button>
            </div>
          </div>

          {/* Filters */}
          <div className="px-4 py-3 border-b border-gray-200 flex flex-wrap gap-3 items-center text-sm">
            <span className="font-medium text-gray-700">FILTER</span>
            <select 
              value={trialFilter} 
              onChange={(e) => setTrialFilter(e.target.value)} 
              className="px-4 py-1 bg-gray-100 border border-gray-300 rounded-md text-sm h-9"
            >
              <option value="">Trial Name</option>
              <option value="trial1">Clinical Trial 1</option>
              <option value="trial2">Clinical Trial 2</option>
            </select>
            <select 
              value={statusFilter} 
              onChange={(e) => setStatusFilter(e.target.value)} 
              className="px-3 py-1 bg-gray-100 border border-gray-300 rounded-md text-sm h-9"
            >
              <option value="">Status</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>

            {/* Date Filter */}
            <div className="flex w-17 items-center gap-2">
              <span className=" text-sm">DATE</span>
              <DatePicker
                selected={fromDate}
                onChange={(date) => setFromDate(date)}
                placeholderText="From"
                className="w-20 h-9 border rounded-lg text-xs px-2 py-1"
                dateFormat="dd/MM/yyyy"
              />
              <DatePicker
                selected={toDate}
                onChange={(date) => setToDate(date)}
                placeholderText="To"
                className="w-20 h-9 border rounded-lg text-xs px-2 py-1"
                dateFormat="dd/MM/yyyy"
              />
            </div>

            {(trialFilter || statusFilter || fromDate || toDate) && (
              <button 
                onClick={() => { setTrialFilter(''); setStatusFilter(''); setFromDate(null); setToDate(null) }} 
                className="text-gray-400 hover:text-gray-600"
              >
                <X className="h-3 w-3" />
              </button>
            )}
          </div>

          {/* Trials Section */}
          {trials.map(trial => (
            <div key={trial.name} className="border-b border-gray-200 last:border-b-0">
              <div className="px-4 py-3 bg-gray-50 flex justify-between items-center">
                <button 
                  onClick={() => toggleTrial(trial.name)} 
                  className="flex items-center space-x-2"
                >
                  <ChevronDown className={`h-4 w-4 transition-transform ${expandedTrials[trial.name] ? 'rotate-180' : ''}`} />
                  <span className="font-medium text-gray-900 text-sm">{trial.name}</span>
                </button>
                <span className="text-xs text-gray-500">{trial.count} Records</span>
              </div>
              {expandedTrials[trial.name] && (
                <div className="overflow-x-auto">
                  <table className="min-w-full divide-y divide-gray-200">
                    <thead className="bg-gray-50">
                      <tr>
                        {['First name', 'Last name', 'Email', 'Status', 'Role', 'Start date', 'End date', 'Actions'].map(header => (
                          <th key={header} className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">{header}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody className="bg-white divide-y divide-gray-200">
                      {filteredCoordinators.map(coordinator => (
                        <tr key={coordinator.id} className="hover:bg-gray-50">
                          <td className="px-4 py-3 text-sm">{coordinator.firstName}</td>
                          <td className="px-4 py-3 text-sm">{coordinator.lastName}</td>
                          <td className="px-4 py-3 text-sm">{coordinator.email}</td>
                          <td className="px-4 py-3 flex items-center space-x-2">
                            {getStatusDot(coordinator.status)}
                            <span className="text-xs">{coordinator.status}</span>
                          </td>
                          <td className="px-4 py-3 text-sm">{coordinator.role}</td>
                          <td className="px-4 py-3 text-sm">{coordinator.startDate}</td>
                          <td className="px-4 py-3 text-sm">{coordinator.endDate || '-'}</td>
                          <td className="px-4 py-3 relative">
                            <button 
                              onClick={(e) => handleCoordinatorAction(coordinator, e)} 
                              className="p-1 hover:bg-gray-100 rounded"
                            >
                              <MoreVertical className="h-4 w-4 text-gray-400" />
                            </button>
                            {showDropdown === coordinator.id && (
                                <div className="absolute right-0 mt-1 w-32 bg-white rounded-md shadow-lg z-10 border text-xs">
                                  <button 
                                    onClick={(e) => { e.stopPropagation(); handleEditCoordinator(coordinator) }}
                                    className="block w-full text-left px-3 py-1 text-gray-700 hover:bg-gray-100"
                                  >
                                    Edit
                                  </button>
                                  <button 
                                    onClick={(e) => { e.stopPropagation(); handleRemoveFromTrial(coordinator) }}
                                    className="block w-full text-left px-3 py-1 text-gray-700 hover:bg-gray-100"
                                  >
                                    Remove from trial
                                  </button>
                                  <button 
                                    onClick={(e) => { e.stopPropagation(); handleDeleteCoordinator(coordinator) }}
                                    className="block w-full text-left px-3 py-1 text-red-600 hover:bg-red-50"
                                  >
                                    Delete user
                                  </button>
                                  </div>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          ))}

          {/* Footer */}
          <div className="px-4 py-3 border-t border-gray-200 flex justify-between items-center">
            <span className="text-sm text-gray-500">{filteredCoordinators.length} records</span>
          </div>
        </div>
      </div>

      {/* Delete Confirmation Modal */}
      {showDeleteModal && coordinatorToDelete && (
        <div className="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-2xl p-6 relative">
            {/* Close (X) */}
            <button onClick={cancelDeleteCoordinator} className="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
              <X className="h-5 w-5" />
            </button>

            {/* Title */}
            <h3 className="text-2xl font-semibold text-gray-900 mb-6">Delete User</h3>

            {/* Warning Row */}
            <div className="flex items-start gap-4 mb-6">
              <div className="flex items-center justify-center w-12 h-12 rounded-full border-4 border-red-200">
                <AlertCircle className="h-6 w-6 text-red-600" />
              </div>
              <div className="text-gray-900">
                <p className="text-xl font-semibold">Are you sure you want to delete this user?</p>
                <p className="text-xl font-semibold">This action can not be be undone.</p>
              </div>
            </div>

            {/* Divider */}
            <div className="border-t border-gray-200 my-4" />

            {/* Details Row */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
              <div>
                <p className="text-lg font-semibold text-gray-900">{coordinatorToDelete.firstName} {coordinatorToDelete.lastName}</p>
                <p className="text-gray-700">{coordinatorToDelete.email}</p>
              </div>
              <div>
                <p className="text-sm font-semibold text-gray-900 mb-1">Site Coordinator</p>
                <ul className="text-gray-700 text-sm space-y-1">
                  <li>GSXK Diabetes</li>
                  <li>GKR4 Diabetes</li>
                  <li>GYDG Diabetes</li>
                </ul>
              </div>
            </div>

            {/* Footer Buttons */}
            <div className="flex items-center justify-between">
              <button
                onClick={cancelDeleteCoordinator}
                className="px-5 py-2.5 rounded-2xl border border-gray-300 text-gray-700 hover:bg-gray-50 flex items-center gap-2"
              >
                <span>Cancel</span>
              </button>
              <button
                onClick={confirmDeleteCoordinator}
                className="px-5 py-2.5 rounded-2xl bg-red-600 text-white hover:bg-red-700 flex items-center gap-2"
              >
                <span>Delete User</span>
                <Trash2 className="h-4 w-4" />
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Remove from Trial Confirmation Modal */}
      {showRemoveModal && coordinatorToRemove && (
        <div className="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
            <h3 className="text-lg font-bold text-gray-900 mb-4">Remove from Trial</h3>
            <p className="text-gray-600 mb-6">
              Are you sure you want to remove {coordinatorToRemove.firstName} {coordinatorToRemove.lastName} from this clinical trial?
            </p>
            <div className="flex justify-end space-x-3">
              <button
                onClick={cancelRemoveFromTrial}
                className="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50"
              >
                Cancel
              </button>
              <button
                onClick={confirmRemoveFromTrial}
                className="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-600"
              >
                Remove
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Remove from Trial Success Modal */}
      {showRemoveSuccessModal && removedCoordinator && (
        <div className="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
            <div className="flex items-center justify-center mb-4">
              <div className="bg-green-100 rounded-full p-2">
                <svg className="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <h3 className="text-lg font-bold text-gray-900 text-center mb-2">Successfully Removed</h3>
            <p className="text-gray-600 text-center mb-6">
              {removedCoordinator.firstName} {removedCoordinator.lastName} has been removed from the clinical trial.
            </p>
            <div className="flex justify-center">
              <button
                onClick={closeRemoveSuccessModal}
                className="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
              >
                OK
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
