'use client'

import { useState, useEffect } from 'react'
import { Eye, EyeOff } from 'lucide-react'
import { useAuth } from '@/contexts/AuthContext'

export default function ProfilePage() {
  const { user, updateProfile } = useAuth()

  // Prevent page scrolling
  useEffect(() => {
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
    return () => {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    };
  }, []);


  const [currentPassword, setCurrentPassword] = useState<string>('')
  const [newPassword, setNewPassword] = useState<string>('')
  const [retypePassword, setRetypePassword] = useState<string>('')

  const [showCurrent, setShowCurrent] = useState<boolean>(false)
  const [showNew, setShowNew] = useState<boolean>(false)
  const [showRetype, setShowRetype] = useState<boolean>(false)

  const [errors, setErrors] = useState<Record<string, string>>({})
  const [submitting, setSubmitting] = useState<boolean>(false)
  const [success, setSuccess] = useState<string>('')
  const [failure, setFailure] = useState<string>('')

  const validatePassword = (password: string) => {
    const minLength = password.length >= 8
    const hasLetter = /[a-zA-Z]/.test(password)
    const hasNumber = /\d/.test(password)
    const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password)
    return minLength && hasLetter && hasNumber && hasSpecial
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    setSuccess('')
    setFailure('')
    setErrors({})

    const newErrors: Record<string, string> = {}

    // Show errors for all password fields
    if (!currentPassword) {
      newErrors.currentPassword = 'Please enter your current password'
    }
    if (!newPassword) {
      newErrors.newPassword = 'Please enter 8+ characters. Include numbers and special characters.'
    } else if (!validatePassword(newPassword)) {
      newErrors.newPassword = 'Please enter 8+ characters. Include numbers and special characters.'
    }
    if (!retypePassword) {
      newErrors.retypePassword = 'Password does not match'
    } else if (newPassword !== retypePassword) {
      newErrors.retypePassword = 'Password does not match'
    }

    if (Object.keys(newErrors).length) {
      setErrors(newErrors)
      return
    }

    setSubmitting(true)
    try {
      let passwordOk = true
      if (newPassword && currentPassword) {
        // Simulate API call for now - replace with actual API when implemented
        await new Promise(resolve => setTimeout(resolve, 500))
        passwordOk = true // Simulate success for now
        
        // TODO: Implement actual API call
        // const resp = await fetch('/api/auth/change-password', {
        //   method: 'POST',
        //   headers: { 'Content-Type': 'application/json' },
        //   body: JSON.stringify({ currentPassword, newPassword }),
        // })
        // passwordOk = resp.ok
        // if (!passwordOk) {
        //   const data = await resp.json().catch(() => ({}))
        //   setFailure(data?.error || 'Failed to change password')
        // }
      }

      if (passwordOk) {
        setSuccess('Your password has been updated.')
        setCurrentPassword('')
        setNewPassword('')
        setRetypePassword('')
      }
    } catch (err) {
      setFailure('Something went wrong')
    } finally {
      setSubmitting(false)
    }
  }

  return (
    <div 
      className="h-screen overflow-hidden flex items-start justify-center p-2 pt-12"
      style={{ 
        backgroundColor: '#F5F5F5',
        paddingTop: '30px',
        paddingBottom: '100px'
      }}
    >
      <div className="bg-white space-x-3 rounded-xl shadow-lg w-full max-w-3xl max-h-[85vh] overflow-y-auto p-4">
        <div className="flex  items-start justify-between mb-4">
         
          <h1 className="text-xl font-normal text-black">Profile</h1>
          {success && (
            <div className="bg-green-600 w-1/2 text-white text-center px-7 py-4 rounded-lg">
              {success}
            </div>
          )}
        </div>
      
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          {/* Left: Your information */}
          <div className="space-y-2">
            <h2 className="text-sm font-semibold text-red-600">Your information</h2>
            <div className="flex flex-col space-y-1">
              <div className="text-base font-bold text-black">
                {user?.firstName && user?.lastName ? `${user.firstName} ${user.lastName}` : 'Craig Johnston'}
              </div>
              <div className="text-sm text-black">
                {user?.email || 'craig.johnston@eversana.com'}
              </div>
            </div>
          </div>

          {/* Right: Change password */}
          <div>
            {/* Confirm Password Section */}
            <div>
              <h2 className="text-xs font-semibold text-red-600 mb-3">Confirm Password</h2>
              <div className="mb-4">
                 <label className={`block text-sm font-bold mb-1 ${errors.currentPassword ? 'text-red-600' : 'text-black'}`}>Current Password</label>
              <div className="relative">
                <input
                  type={showCurrent ? 'text' : 'password'}
                  value={currentPassword}
                  onChange={(e) => {
                    setCurrentPassword(e.target.value)
                    if (errors.currentPassword) {
                      setErrors(prev => ({ ...prev, currentPassword: '' }))
                    }
                  }}
                     className={`w-full px-2 py-1 bg-gray-100 focus:outline-none focus:ring-1 focus:ring-red-500 ${
                    errors.currentPassword 
                         ? 'border border-red-500 rounded-t' 
                         : 'rounded'
                  }`}
                />
                   <button type="button" onClick={() => setShowCurrent(!showCurrent)} className={`absolute right-2 top-1/2 -translate-y-1/2 ${errors.currentPassword ? 'text-red-500' : 'text-gray-500'}`}>
                  {showCurrent ? <EyeOff size={16} /> : <Eye size={16} />}
                </button>
              </div>
                <div className={`w-full text-xs px-3 py-2 rounded-b ${errors.currentPassword ? 'bg-red-600 text-white' : 'invisible h-0'}`}>
                  {errors.currentPassword || 'placeholder'}
                </div>
                </div>
            </div>

            {/* Change Password Section */}
            <div className="mt-6">
              <h2 className="text-xs font-semibold text-red-600 mb-3">Change Password</h2>

              <div className="mb-3">
                 <label className={`block text-sm font-bold mb-1 ${errors.newPassword ? 'text-red-600' : 'text-black'}`}>New Password</label>
              <div className="relative">
                <input
                  type={showNew ? 'text' : 'password'}
                  value={newPassword}
                  onChange={(e) => {
                    setNewPassword(e.target.value)
                    if (errors.newPassword) {
                      setErrors(prev => ({ ...prev, newPassword: '' }))
                    }
                  }}
                     className={`w-full px-2 py-1 bg-gray-100 focus:outline-none focus:ring-1 focus:ring-red-500 ${
                    errors.newPassword 
                         ? 'border border-red-500 rounded-t' 
                         : 'rounded'
                  }`}
                />
                   <button type="button" onClick={() => setShowNew(!showNew)} className={`absolute right-2 top-1/2 -translate-y-1/2 ${errors.newPassword ? 'text-red-500' : 'text-gray-500'}`}>
                  {showNew ? <EyeOff size={16} /> : <Eye size={16} />}
                </button>
              </div>
                <div className={`w-full text-xs px-3 py-2 rounded-b ${errors.newPassword ? 'bg-red-600 text-white' : 'invisible h-0'}`}>
                  {errors.newPassword || 'placeholder'}
                </div>
            </div>

              <div className="mb-3">
                 <label className={`block text-sm font-bold mb-1 ${errors.retypePassword ? 'text-red-600' : 'text-black'}`}>Retype Password</label>
              <div className="relative">
                <input
                  type={showRetype ? 'text' : 'password'}
                  value={retypePassword}
                  onChange={(e) => {
                    setRetypePassword(e.target.value)
                    if (errors.retypePassword) {
                      setErrors(prev => ({ ...prev, retypePassword: '' }))
                    }
                  }}
                     className={`w-full px-2 py-1 bg-gray-100 focus:outline-none focus:ring-1 focus:ring-red-500 ${
                    errors.retypePassword 
                         ? 'border border-red-500 rounded-t' 
                         : 'rounded'
                  }`}
                />
                   <button type="button" onClick={() => setShowRetype(!showRetype)} className={`absolute right-2 top-1/2 -translate-y-1/2 ${errors.retypePassword ? 'text-red-500' : 'text-gray-500'}`}>
                  {showRetype ? <EyeOff size={16} /> : <Eye size={16} />}
                </button>
              </div>
                <div className={`w-full text-xs px-3 py-2 rounded-b ${errors.retypePassword ? 'bg-red-600 text-white' : 'invisible h-0'}`}>
                  {errors.retypePassword || 'placeholder'}
                </div>
            </div>

            <p className="text-xs text-gray-600">Your password should be at least 8 characters long and include a mix of letters, numbers, and special characters (like !, $, or #).</p>
            </div>
          </div>
        </div>

        {failure && (
          <div className="mt-6 p-3 rounded bg-red-50 text-red-700">
            {failure}
          </div>
        )}

        <div className="flex justify-end mt-4">
          <button
            onClick={handleSubmit}
            disabled={submitting}
            className={`bg-gray-100 text-black px-4 py-2 rounded-full flex items-center gap-2 text-sm ${submitting ? 'opacity-50 cursor-not-allowed' : ''}`}
          >
            submit
            <span className="ml-1">›</span>
          </button>
        </div>
      </div>
    </div>
  )
}


