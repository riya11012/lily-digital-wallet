        private static void DrawProgressBar()
        {
            lock (_consoleLock)
            {
                double percent = TotalFolders == 0
                    ? 1
                    : (double)ProcessedFolders / TotalFolders;

                int barLength = 40;
                int filled = (int)(percent * barLength);
                string bar = "[" + new string('█', filled) + new string('░', barLength - filled) + "]";

                // ETA calculation
                double elapsedSec = _stopwatch.Elapsed.TotalSeconds;
                double etaSec = 0;

                if (ProcessedFolders > 0)
                {
                    double inst = elapsedSec / ProcessedFolders;

                    // Smooth ETA for stable display
                    _smoothedSecondsPerFolder =
                        _smoothedSecondsPerFolder == 0
                        ? inst
                        : (SMOOTH_ALPHA * inst) + ((1 - SMOOTH_ALPHA) * _smoothedSecondsPerFolder);

                    int remaining = TotalFolders - ProcessedFolders;
                    etaSec = remaining * _smoothedSecondsPerFolder;
                }

                string etaFormatted = TimeSpan.FromSeconds(etaSec).ToString(@"hh\:mm\:ss");
                string elapsedFormatted = TimeSpan.FromSeconds(elapsedSec).ToString(@"hh\:mm\:ss");

                // Draw progress line (overwrite)
                Console.SetCursorPosition(0, Console.CursorTop);
                Console.Write(
                    $"{bar} {percent * 100:0.0}%  " +
                    $"({ProcessedFolders}/{TotalFolders})  " +
                    $"ETA: {etaFormatted}  " +
                    $"Elapsed: {elapsedFormatted}    "
                );
            }
        }


        private static void UpdateProgress()
        {
            int prev = Interlocked.Increment(ref ProcessedFolders);
            DrawProgressBar();
        }


        private static async Task ProcessFolderAsync(string folderRelativeUrl, TransferUtility transferUtility, HashSet<string> doneSet, CancellationToken ct)
        {
            List<FileResult> files;
            try
            {
                files = await RetryAsync(() => GetFilesInFolderSafe(folderRelativeUrl), MaxRetries, ct);
                if (files == null || files.Count == 0)
                {
                    AppendCsv(LogCsv, $"{EscapeCsv(folderRelativeUrl)},, ,0,NO_FILES,No files in folder,{DateTime.UtcNow:O}");
                    AppendCheckpoint(CheckpointFile, folderRelativeUrl);
                    UpdateProgress();
                    return;
                }
            }
            catch (Exception ex)
            {
                _missing.Add(new MissingResult { FolderUrl = folderRelativeUrl, ErrorMessage = "List error: " + ex.Message });
                AppendCsv(ErrorCsv, $"{EscapeCsv(folderRelativeUrl)},{EscapeCsv(ex.Message)},{DateTime.UtcNow:O}");
                UpdateProgress();
                return;
            }

            var downloadSemaphore = new SemaphoreSlim(MaxDownloadParallelism);
            var uploadSemaphore = new SemaphoreSlim(MaxUploadParallelism);

            var fileResults = new ConcurrentBag<bool>();
            var tasks = new List<Task>();

            foreach (var f in files)
            {
                tasks.Add(Task.Run(async () =>
                {
                    await downloadSemaphore.WaitAsync(ct);
                    string tempFile = null;
                    try
                    {
                        tempFile = await RetryAsync(() => Task.FromResult(DownloadFileSafe(f.ServerRelativeUrl)), MaxRetries, ct);

                        string trimmed = folderRelativeUrl.TrimStart('/');
                        string s3Key = $"Documents/{trimmed}/{f.Name}";

                        await uploadSemaphore.WaitAsync(ct);
                        try
                        {
                            await RetryAsync(() => Task.Run(() => UploadFileSafe(transferUtility, tempFile, s3Key)), MaxRetries, ct);
                        }
                        finally
                        {
                            uploadSemaphore.Release();
                        }

                        AppendCsv(LogCsv, $"{EscapeCsv(folderRelativeUrl)},{EscapeCsv(f.Name)},{EscapeCsv(s3Key)},{f.Length},OK,Uploaded,{DateTime.UtcNow:O}");
                        fileResults.Add(true);
                    }
                    catch (Exception ex)
                    {
                        fileResults.Add(false);
                        AppendCsv(LogCsv, $"{EscapeCsv(folderRelativeUrl)},{EscapeCsv(f.Name)},,{f.Length},FAILED,{EscapeCsv(ex.Message)},{DateTime.UtcNow:O}");
                        _missing.Add(new MissingResult { FolderUrl = folderRelativeUrl, ErrorMessage = $"File {f.Name} -> {ex.Message}" });
                    }
                    finally
                    {
                        downloadSemaphore.Release();
                        if (tempFile != null && System.IO.File.Exists(tempFile)) { try { System.IO.File.Delete(tempFile); } catch { } }
                    }
                }, ct));
            }

            await Task.WhenAll(tasks);

            if (fileResults.All(x => x))
            {
                AppendCheckpoint(CheckpointFile, folderRelativeUrl);
            }

            UpdateProgress();
        }

        private static Task<List<FileResult>> GetFilesInFolderSafe(string folderRelativeUrl)
        {
            return Task.Run(() =>
            {
                var list = new List<FileResult>();
                using (var ctx = new ClientContext(SiteUrl))
                {
                    ctx.Credentials = new NetworkCredential(SpUser, SpPass, SpDomain);
                    var folder = ctx.Web.GetFolderByServerRelativeUrl(folderRelativeUrl);
                    ctx.Load(folder.Files, fs => fs.Include(f => f.Name, f => f.Length, f => f.ServerRelativeUrl));
                    try { ctx.ExecuteQuery(); }
                    catch (WebException we)
                    {
                        string msg = we.Message;
                        if (we.Response is HttpWebResponse resp) msg += $" HTTP {(int)resp.StatusCode} {resp.StatusCode}";
                        throw new Exception("SharePoint list error: " + msg, we);
                    }

                    foreach (SPFile spf in folder.Files)
                    {
                        list.Add(new FileResult { ServerRelativeUrl = spf.ServerRelativeUrl, Name = spf.Name, Length = spf.Length });
                    }
                }
                return list;
            });
        }

        private static string DownloadFileSafe(string serverRelativeUrl)
        {
            using (var ctx = new ClientContext(SiteUrl))
            {
                ctx.Credentials = new NetworkCredential(SpUser, SpPass, SpDomain);

                try
                {
                    var fileInfo = SPFile.OpenBinaryDirect(ctx, serverRelativeUrl);
                    string ext = Path.GetExtension(serverRelativeUrl);
                    string tempFile = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N") + ext);

                    using (var fs = new FileStream(tempFile, FileMode.Create, FileAccess.Write))
                    {
                        fileInfo.Stream.CopyTo(fs);
                    }

                    return tempFile;
                }
                catch (WebException we)
                {
                    string msg = we.Message;
                    if (we.Response is HttpWebResponse resp) msg += $" HTTP {(int)resp.StatusCode} {resp.StatusCode}";
                    throw new Exception("Download error: " + msg, we);
                }
            }
        }

        private static void UploadFileSafe(TransferUtility transferUtility, string localPath, string s3Key)
        {
            if (!System.IO.File.Exists(localPath)) throw new FileNotFoundException("Temp file missing: " + localPath);

            var request = new TransferUtilityUploadRequest
            {
                BucketName = BucketName,
                FilePath = localPath,
                Key = s3Key
            };

            try { transferUtility.Upload(request); }
            catch (Exception ex) { throw new Exception("S3 upload error: " + ex.Message, ex); }
        }

        private static async Task<T> RetryAsync<T>(Func<Task<T>> action, int maxRetries, CancellationToken ct)
        {
            int attempt = 0; Exception lastEx = null;
            while (attempt < maxRetries)
            {
                ct.ThrowIfCancellationRequested();
                try { return await action(); }
                catch (Exception ex) { lastEx = ex; attempt++; if (attempt >= maxRetries) break; var delay = TimeSpan.FromMilliseconds(BaseBackoff.TotalMilliseconds * Math.Pow(2, attempt - 1)); await Task.Delay(delay, ct); }
            }
            throw lastEx ?? new Exception("Unknown retry failure");
        }

        private static async Task RetryAsync(Func<Task> action, int maxRetries, CancellationToken ct)
        {
            await RetryAsync(async () => { await action(); return true; }, maxRetries, ct);
        }

        private static HashSet<string> LoadCheckpoint(string path)
        {
            var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (!System.IO.File.Exists(path)) return set;
            foreach (var l in System.IO.File.ReadAllLines(path)) if (!string.IsNullOrWhiteSpace(l)) set.Add(l.Trim());
            return set;
        }

        private static void AppendCheckpoint(string path, string folderRelativeUrl) { lock (_csvLock) { System.IO.File.AppendAllLines(path, new[] { folderRelativeUrl }); } }
        private static void EnsureCsvHeader(string csvPath, string header) { lock (_csvLock) { if (!System.IO.File.Exists(csvPath)) { System.IO.File.WriteAllText(csvPath, header + Environment.NewLine, Encoding.UTF8); } } }
        private static void AppendCsv(string csvPath, string line) { lock (_csvLock) { System.IO.File.AppendAllText(csvPath, line + Environment.NewLine, Encoding.UTF8); } }
        private static string EscapeCsv(string s) { if (s == null) return ""; if (s.Contains(",") || s.Contains("\"") || s.Contains("\n")) return $"\"{s.Replace("\"", "\"\"")}\""; return s; }
    }

    public static class CsvReader
    {
        public static DataTable ReadCSV(string path)
        {
            var dt = new DataTable();

            using (var sr = new StreamReader(path))
            {
                bool firstLine = true;

                while (!sr.EndOfStream)
                {
                    string line = sr.ReadLine();
                    if (string.IsNullOrWhiteSpace(line)) continue;

                    string[] parts = ParseCsvLine(line);

                    if (firstLine)
                    {
                        foreach (var col in parts)
                            dt.Columns.Add(col.Trim());
                        firstLine = false;
                    }
                    else
                    {
                        var row = dt.NewRow();
                        for (int i = 0; i < dt.Columns.Count && i < parts.Length; i++)
                            row[i] = parts[i];
                        dt.Rows.Add(row);
                    }
                }
            }

            return dt;
        }

        private static string[] ParseCsvLine(string line)
        {
            var result = new List<string>();
            bool insideQuotes = false;
            var sb = new StringBuilder();

            foreach (char c in line)
            {
                if (c == '"')
                {
                    insideQuotes = !insideQuotes;
                    continue;
                }

                if (c == ',' && !insideQuotes)
                {
                    result.Add(sb.ToString());
                    sb.Clear();
                }
                else
                {
                    sb.Append(c);
                }
            }

            result.Add(sb.ToString());
            return result.ToArray();
        }
    }
