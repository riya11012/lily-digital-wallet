using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Data;
using System.Diagnostics;
using System.IO;
using System.Linq;
using System.Net;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.SharePoint.Client;
using Microsoft.VisualBasic.FileIO;

using IOFile = System.IO.File;
using SPFile = Microsoft.SharePoint.Client.File;

namespace SharePointBatchDownloader_CSVSplit
{
    // ===================== MODELS =====================
    public class FileResult
    {
        public int SrNo { get; set; }
        public string Entity { get; set; }
        public string FileName { get; set; }
        public long SizeBytes { get; set; }
        public double SizeKB { get; set; }
        public string SharepointDocumentURL { get; set; }
    }

    public class MissingResult
    {
        public string Entity { get; set; }
        public string FolderUrl { get; set; }
        public string ErrorMessage { get; set; }
    }

    // ===================== SHAREPOINT HELPER =====================
    public class SharePointHelperOptimized
    {
        private readonly string _siteUrl;
        private readonly ICredentials _creds;

        public SharePointHelperOptimized(string siteUrl, ICredentials creds)
        {
            _siteUrl = siteUrl;
            _creds = creds;
        }

        public Task<List<FileResult>> GetFilesForFolderAsync(
            string entity, string relativeUrl, CancellationToken ct)
        {
            return Task.Run(() =>
            {
                var results = new List<FileResult>();

                string folderRelativeUrl =
                    relativeUrl.StartsWith("/")
                        ? relativeUrl.TrimEnd('/')
                        : "/" + entity.Trim('/') + "/" + relativeUrl.Trim('/');

                try
                {
                    using (var ctx = new ClientContext(_siteUrl))
                    {
                        ctx.Credentials = _creds;
                        ctx.RequestTimeout = Timeout.Infinite;

                        var folder = ctx.Web.GetFolderByServerRelativeUrl(folderRelativeUrl);
                        ctx.Load(folder.Files, fs =>
                            fs.Include(f => f.Name, f => f.Length, f => f.ServerRelativeUrl));
                        ctx.ExecuteQuery();

                        int sr = 1;
                        foreach (SPFile f in folder.Files)
                        {
                            results.Add(new FileResult
                            {
                                SrNo = sr++,
                                Entity = entity,
                                FileName = f.Name,
                                SizeBytes = f.Length,
                                SizeKB = Math.Round(f.Length / 1024.0, 2),
                                SharepointDocumentURL = _siteUrl.TrimEnd('/') + folderRelativeUrl
                            });
                        }
                    }
                }
                catch (Exception ex)
                {
                    Program.MissingItems.Add(new MissingResult
                    {
                        Entity = entity,
                        FolderUrl = folderRelativeUrl,
                        ErrorMessage = ex.Message
                    });
                  //  throw;
                }

                return results;
            }, ct);
        }
    }



    // ===================== CSV READER =====================
    public static class CSVReader
    {
        public static DataTable ReadCSV(string path)
        {
            var dt = new DataTable();
            using (var parser = new TextFieldParser(path))
            {
                parser.TextFieldType = Microsoft.VisualBasic.FileIO.FieldType.Delimited;
                parser.SetDelimiters(",");
                parser.HasFieldsEnclosedInQuotes = true;

                foreach (var h in parser.ReadFields())
                    dt.Columns.Add(h);

                while (!parser.EndOfData)
                    dt.Rows.Add(parser.ReadFields());
            }
            return dt;
        }
    }

    // ===================== PROCESS CONTROLLER =====================
    public class ProcessControllerOptimized
    {
        private readonly DataTable _folders;
        private readonly SharePointHelperOptimized _helper;
        private readonly int _totalCount;
        private readonly int _batchSize;

        private readonly Stopwatch _sw = Stopwatch.StartNew();
        private readonly object _consoleLock = new object();

        private int _processedFolders = 0;
        private long _processedFiles = 0;

        private int _currentParallel;
        private readonly int _maxParallel;
        private readonly int _minParallel = 5;

        private int _success = 0;
        private int _errors = 0;

        public ProcessControllerOptimized(
            DataTable dt, int maxParallel, SharePointHelperOptimized helper, int batchSize)
        {
            _folders = dt;
            _helper = helper;
            _totalCount = dt.Rows.Count;
            _batchSize = batchSize;

            _maxParallel = maxParallel;
            _currentParallel = Math.Max(5, maxParallel / 2);
        }

        public async Task StartInChunksAsync(
            CancellationToken ct,
            int chunkSize,
            Action<List<FileResult>, int> onChunk)
        {
            var buffer = new List<FileResult>();
            int chunkNo = 1;

            for (int i = 0; i < _totalCount; i += _batchSize)
            {
                var batch = _folders.AsEnumerable().Skip(i).Take(_batchSize).ToList();
                var bag = new ConcurrentBag<FileResult>();
                var throttler = new SemaphoreSlim(_currentParallel);

                var tasks = batch.Select(async row =>
                {
                    await throttler.WaitAsync(ct);
                    try
                    {
                        string entity = row["Entity"].ToString();
                        string path = row["RelativeURL"].ToString();

                        var files = await _helper.GetFilesForFolderAsync(entity, path, ct);
                        foreach (var f in files)
                        {
                            bag.Add(f);
                            Interlocked.Increment(ref _processedFiles);
                        }

                        Interlocked.Increment(ref _success);
                    }
                    catch
                    {
                        Interlocked.Increment(ref _errors);
                    }
                    finally
                    {
                        int done = Interlocked.Increment(ref _processedFolders);
                        PrintProgress(done);
                        throttler.Release();
                    }
                });

                await Task.WhenAll(tasks);
                AdjustParallelism();

                buffer.AddRange(bag);
                while (buffer.Count >= chunkSize)
                {
                    var emit = buffer.Take(chunkSize).ToList();
                    buffer.RemoveRange(0, chunkSize);
                    onChunk(emit, chunkNo++);
                }
            }

            if (buffer.Count > 0)
                onChunk(buffer, chunkNo);
        }

        private void AdjustParallelism()
        {
            int total = _success + _errors;
            if (total < 20) return;

            double errorRate = (double)_errors / total;
            if (errorRate < 0.05 && _currentParallel < _maxParallel)
                _currentParallel++;
            else if (errorRate > 0.15 && _currentParallel > _minParallel)
                _currentParallel--;

            _success = _errors = 0;
        }

        private void PrintProgress(int done)
        {
            double pct = (double)done / _totalCount;
            int barLen = 30;
            int filled = (int)(pct * barLen);

            string bar = new string('█', filled) + new string('-', barLen - filled);

            double sec = _sw.Elapsed.TotalSeconds;
            double folderRate = done / Math.Max(1, sec);
            double fileRate = _processedFiles / Math.Max(1, sec);

            double eta = folderRate > 0
                ? (_totalCount - done) / folderRate
                : 0;

            lock (_consoleLock)
            {
                Console.Write(
                    $"\r[{bar}] {pct * 100:0.00}% | " +
                    $"Folders {done}/{_totalCount} ({folderRate:0.0}/s) | " +
                    $"Files {_processedFiles:N0} ({fileRate:0.0}/s) | " +
                    $"Parallel {_currentParallel} | ETA {TimeSpan.FromSeconds(eta):hh\\:mm\\:ss}   ");
            }
        }
    }

    // ===================== PROGRAM =====================
    public class Program
    {
        public static ConcurrentBag<MissingResult> MissingItems = new ConcurrentBag<MissingResult>();

        static async Task Main()
        {
            ServicePointManager.DefaultConnectionLimit = 200;
            ServicePointManager.Expect100Continue = false;

            string siteUrl = "https://spcrm.triplefin.com/";
            string csvPath = @"C:\Ajay\CRMCore\SharepointDocumentLocation\tf_patientproductenrollment.csv";

            var creds = new NetworkCredential("ajay.ghosalkar", "AG01052026!", "TRIFIN");
            var helper = new SharePointHelperOptimized(siteUrl, creds);
            var table = CSVReader.ReadCSV(csvPath);

            var controller = new ProcessControllerOptimized(
                table, maxParallel: 50, helper, batchSize: 100);

            await controller.StartInChunksAsync(
                CancellationToken.None,
                chunkSize: 50000,
                (chunk, part) =>
                {
                    string file = $"tf_patientproductenrollment_Output_Part_{part}.csv";
                    WriteCsv(chunk, file);
                    chunk.Clear();
                });

            if (!MissingItems.IsEmpty)
                WriteMissingCsv(MissingItems.ToList(), "MissingFiles.csv");

            Console.WriteLine("\nCompleted. Press Enter.");
            Console.ReadLine();
        }

        // ===================== CSV WRITERS =====================
        private static void WriteCsv(List<FileResult> rows, string path)
        {
            using var sw = new StreamWriter(path, false, new UTF8Encoding(true));
            sw.WriteLine("\"SrNo\",\"Entity\",\"FileName\",\"SizeBytes\",\"SizeKB\",\"URL\"");
            foreach (var r in rows)
                sw.WriteLine($"\"{r.SrNo}\",\"{r.Entity}\",\"{r.FileName}\",\"{r.SizeBytes}\",\"{r.SizeKB}\",\"{r.SharepointDocumentURL}\"");
        }

        private static void WriteMissingCsv(List<MissingResult> rows, string path)
        {
            using var sw = new StreamWriter(path, false, new UTF8Encoding(true));
            sw.WriteLine("\"Entity\",\"FolderUrl\",\"Error\"");
            foreach (var r in rows)
                sw.WriteLine($"\"{r.Entity}\",\"{r.FolderUrl}\",\"{r.ErrorMessage}\"");
        }
    }
}

