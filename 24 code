'use client';

import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import toast from 'react-hot-toast';
import { useAuth } from '@/contexts/AuthContext';

interface ValidationErrors {
  email?: string;
  password?: string;
  general?: string;
}

export default function LoginCard() {
  const { setUser } = useAuth();
  const router = useRouter();
  const [isLoading, setIsLoading] = useState(false);
  const [formData, setFormData] = useState({
    email: '',
    password: '',
  });
  const [rememberMe, setRememberMe] = useState(false);
  const [errors, setErrors] = useState<ValidationErrors>({});
  const [touched, setTouched] = useState({
    email: false,
    password: false,
  });

  // Load remembered email on component mount
  useEffect(() => {
    const rememberedEmail = localStorage.getItem('rememberMe_email');
    if (rememberedEmail) {
      setFormData(prev => ({ ...prev, email: rememberedEmail }));
      setRememberMe(true);
    }
  }, []);

  // Email validation regex
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  // Validate email format
  const validateEmail = (email: string): string | null => {
    if (!email.trim()) {
      return 'Email is required';
    }
    if (!emailRegex.test(email)) {
      return 'Please enter a valid email address';
    }
    return null;
  };

  // Validate password
  const validatePassword = (password: string): string | null => {
    if (!password.trim()) {
      return 'Password is required';
    }
    if (password.length < 6) {
      return 'Password must be at least 6 characters';
    }
    return null;
  };

  // Validate all fields
  const validateForm = (): boolean => {
    const newErrors: ValidationErrors = {};

    const emailError = validateEmail(formData.email);
    if (emailError) newErrors.email = emailError;

    const passwordError = validatePassword(formData.password);
    if (passwordError) newErrors.password = passwordError;

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setFormData({
      ...formData,
      [name]: value,
    });

    // Clear error when user starts typing
    if (errors[name as keyof ValidationErrors]) {
      setErrors({
        ...errors,
        [name]: undefined,
      });
    }
  };

  const handleBlur = (e: React.FocusEvent<HTMLInputElement>) => {
    const { name } = e.target;
    setTouched({
      ...touched,
      [name]: true,
    });

    // Validate on blur
    if (name === 'email') {
      const emailError = validateEmail(formData.email);
      if (emailError) {
        setErrors({ ...errors, email: emailError });
      }
    } else if (name === 'password') {
      const passwordError = validatePassword(formData.password);
      if (passwordError) {
        setErrors({ ...errors, password: passwordError });
      }
    }
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();

    // Mark all fields as touched
    setTouched({
      email: true,
      password: true,
    });

    // Validate form
    if (!validateForm()) {
      toast.error('Please fix the errors below');
      return;
    }

    setIsLoading(true);
    setErrors({});

    try {
      console.log('[LoginCard] Sending login request with credentials: include');

      const response = await fetch('/api/auth/login', {
        credentials: 'include',
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          email: formData.email.trim(),
          password: formData.password,
          rememberMe,
        }),
      });

      const data = await response.json();    

      if (response.ok) {
        // Store token if provided
        if (data.token) {
          localStorage.setItem('authToken', data.token);
        }

        //Transform login response to match User interface
        const normalizedUser = {
          id: String(data.user.id),
          first_name: data.user.firstName,
          last_name: data.user.lastName,
          email_id: data.user.email,
          role_id: data.user.roleId,
          role: {
            id: data.user.roleId,
            role_name: data.user.role,
          },
        };

        localStorage.setItem('user', JSON.stringify(normalizedUser));
        setUser(normalizedUser);
        
        // ✅ Store email if "remember me" is checked
        if (rememberMe) {
          localStorage.setItem('rememberMe_email', formData.email.trim());
        } else {
          localStorage.removeItem('rememberMe_email');
        }
        
        toast.success('Login successful!');

        // Reset form
        setFormData({ email: '', password: '' });
        setRememberMe(false);

        //Role-based redirect
        let redirectPath = '/users'; // Default for SUPER_ADMIN
        
        if (data.user.roleId === 2 || data.user.roleId === 3) {
          redirectPath = '/wallet-invites'; // Study and Site Coordinator
        }

        router.push(redirectPath);
      } else {
        // Display the specific error message from the API
        const errorMessage =
          data.error || 'The Email or password you provided did not match our records. Please try Again.';
        setErrors({ general: errorMessage });
        toast.error(errorMessage);
      }
    } catch (error) {
      console.error('Login error:', error);
      const errorMessage = 'An error occurred during login. Please try again later.';
      setErrors({ general: errorMessage });
      toast.error(errorMessage);
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div 
      className="flex overflow-hidden shadow-2xl bg-white w-full max-w-[900px] h-fixed h-[400px]"
      style={{
        borderRadius: '20px',
        opacity: 1,
        aspectRatio: '2 / 1'
      }}
    >
      {/* Left Section (Logo / Branding) */}
      <div className="w-1/2 bg-[#D31610] text-white flex items-center justify-center overflow-hidden">
        <img src="/lilly.jpg" alt="Logo" className="w-full h-full object-cover" />
      </div>

      {/* Right Section (Login Form) */}
      <div className="w-1/2 flex flex-col justify-center px-8 sm:px-10 md:px-14">
        <h2 
          className="text-[#D52B1E] mb-3"
          style={{
            fontFamily: 'IBM Plex Sans',
            fontWeight: 700,
            fontStyle: 'normal',
            fontSize: '30px',
            lineHeight: '100%',
            letterSpacing: '0%',
            textTransform: 'capitalize'
          }}
        >
          Login
        </h2>

        {/* General Error Message */}
        {errors.general && (
          <div className="mb-4 p-1 bg-red-50 border border-red-300 rounded-lg text-red-700 text-sm flex items-start gap-2">
            <svg className="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clipRule="evenodd" />
            </svg>
            <span>{errors.general}</span>
          </div>
        )}

        <form className="space-y-0.5" onSubmit={handleSubmit}>
          <div className="relative">
            <img 
              src="/user.png" 
              alt="User" 
              className="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 pointer-events-none z-10"
            />
            <input
              id="email"
              name="email"
              type="email"
              autoComplete="email"
              required
              value={formData.email}
              onChange={handleChange}
              onBlur={handleBlur}
              disabled={isLoading}
              placeholder="Enter your email"
              className="w-full pl-10 pr-4 bg-gray-100 focus:outline-none focus:ring-2 focus:ring-[#D31610] disabled:opacity-50"
              style={{
                height: '46px',
                opacity: 1,
                borderTopLeftRadius: '8px',
                borderTopRightRadius: '8px',
              }}
            />
          </div>

          <div className="relative">
            <img 
              src="/unlock.png" 
              alt="Password" 
              className="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 pointer-events-none z-10"
            />
            <input
              id="password"
              name="password"
              type="password"
              autoComplete="current-password"
              required
              value={formData.password}
              onChange={handleChange}
              onBlur={handleBlur}
              disabled={isLoading}
              placeholder="Password"
              className="w-full pl-10 pr-4 bg-gray-100 focus:outline-none focus:ring-2 focus:ring-[#D31610] disabled:opacity-50"
              style={{
                height: '46px',
                opacity: 1,
              }}
            />
          </div>

          <button
            type="submit"
            disabled={isLoading}
            className="w-full bg-[#D31610] text-white font-semibold hover:bg-red-700 transition disabled:opacity-50 disabled:cursor-not-allowed"
            style={{
              height: '46px',
              opacity: 1,
              borderBottomRightRadius: '8px',
              borderBottomLeftRadius: '8px',
              borderTopLeftRadius: '0px',
              borderTopRightRadius: '0px'
            }}
          >
            {isLoading ? (
              <span className="flex items-center justify-center">
                <svg
                  className="animate-spin -ml-1 mr-3 h-5 w-5 text-white"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    className="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    strokeWidth="4"
                  ></circle>
                  <path
                    className="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
                Signing in...
              </span>
            ) : (
              'Login'
            )}
          </button>
        </form>

        <div className="mt-3">
          <a 
            href="/ForgotPassword" 
            className="text-blue-600 hover:underline"
            style={{
              fontFamily: 'Red Hat Text',
              fontWeight: 400,
              fontStyle: 'normal',
              fontSize: '14px',
              lineHeight: '20px',
              letterSpacing: '0px'
            }}
          >
            Forgot Password
          </a>
        </div>

        <p className="text-xs text-gray-500 pt-14">
          For help logging in or accessing the portal, please contact{' '}
          <span className="font-semibold">Lilly Support</span>.
        </p>
      </div>
    </div>
  );
}
