@tailwind base;
@tailwind components;
@tailwind utilities;
:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

/* Category button 3-line clamp effect */
.category-item {
  width: 200px;
}
.category-item p {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* Small variant for category button */
.category-item--sm {
  width: 140px;
}
.category-item--sm svg {
  width: 20px;
  height: 20px;
}
.root-portal, html, body {
  overflow: visible;
}

/* React DatePicker Styles */
.react-datepicker-wrapper {
  display: inline-block;
  padding: 0;
  border: 0;
  width: 100%;
}

.react-datepicker {
  font-family: inherit;
  font-size: 0.875rem;
  background-color: #fff;
  color: #000;
  border: 1px solid #aeaeae;
  border-radius: 0.3rem;
  display: inline-block;
  position: relative;
}

.react-datepicker__triangle {
  position: absolute;
  left: 50px;
}

.react-datepicker__header {
  text-align: center;
  background-color: #f0f0f0;
  border-bottom: 1px solid #aeaeae;
  border-top-left-radius: 0.3rem;
  border-top-right-radius: 0.3rem;
  padding-top: 8px;
  position: relative;
}

.react-datepicker__current-month {
  margin-top: 0;
  color: #000;
  font-weight: 500;
  font-size: 0.875rem;
}

.react-datepicker__navigation {
  background: none;
  line-height: 1.7;
  text-align: center;
  cursor: pointer;
  position: absolute;
  top: 10px;
  width: 0;
  padding: 0;
  border: none;
  z-index: 1;
  height: 32px;
  width: 32px;
  text-indent: -999em;
  overflow: hidden;
}

.react-datepicker__navigation--previous {
  left: 10px;
}

.react-datepicker__navigation--next {
  right: 10px;
}

.react-datepicker__navigation:hover {
  background-color: #f0f0f0;
  border-radius: 50%;
}

.react-datepicker__day-names {
  margin-bottom: 0.5rem;
  text-align: center;
}

.react-datepicker__day-name {
  color: #000;
  display: inline-block;
  width: 1.7rem;
  line-height: 1.7;
  text-align: center;
  margin: 0.166rem;
}

.react-datepicker__month {
  margin: 0.4rem;
  text-align: center;
}

.react-datepicker__week {
  white-space: nowrap;
  line-height: 1.7;
}

.react-datepicker__day {
  color: #000;
  display: inline-block;
  width: 1.7rem;
  line-height: 1.7;
  text-align: center;
  margin: 0.166rem;
  cursor: pointer;
}

.react-datepicker__day:hover {
  border-radius: 0.3rem;
  background-color: #f0f0f0;
}

.react-datepicker__day--selected {
  background-color: #0066cc;
  color: #fff;
  border-radius: 0.3rem;
}

.react-datepicker__day--selected:hover {
  background-color: #0066cc;
}

.react-datepicker__day--keyboard-selected {
  background-color: #0066cc;
  color: #fff;
  border-radius: 0.3rem;
}

.react-datepicker__day--today {
  font-weight: bold;
}

.react-datepicker__day--disabled {
  color: #ccc;
  cursor: default;
}

.react-datepicker__day--disabled:hover {
  background-color: transparent;
}

/* High z-index for date picker */
.date-picker-high-z-index {
  z-index: 9999;
}

/* Custom styles for the date picker input */


.react-datepicker__input-container input:focus {
  border-color: #ef4444;
  box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.2);
}

/* Force width for wallet-invites date pickers */
.wallet-invites-datepicker .react-datepicker__input-container input {
  width: 48px !important; /* w-12 = 48px */
}


'use client'

import { useState, useEffect, useRef } from 'react'
import { useRouter } from 'next/navigation'
import { Search, Plus, ChevronDown, MoreVertical, X, Calendar, ArrowRight } from 'lucide-react'
import DatePicker from 'react-datepicker'
import 'react-datepicker/dist/react-datepicker.css'

interface UserData {
  id: string
  firstName: string
  lastName: string
  email: string
  status: 'Active' | 'Inactive'
  role: string
  startDate: string
  endDate?: string
  trial: string
}

export default function DashboardPage() {
  const router = useRouter()
  
  const sampleUsers: UserData[] = [
    { id: '1', firstName: 'Audra', lastName: 'Luettgen', email: 'Audra.Luettgen@domain.ext', status: 'Active', role: 'Study Coord.', startDate: '15/01/2024', endDate: '15/12/2024', trial: 'Clinical Trial 1' },
    { id: '2', firstName: 'Augustus', lastName: 'Daugherty', email: 'Augustus.Daugherty@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '20/02/2024', endDate: '20/11/2024', trial: 'Clinical Trial 1' },
    { id: '3', firstName: 'Dessie', lastName: 'Grady', email: 'Dessie.Grady@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '10/03/2024', endDate: '10/10/2024', trial: 'Clinical Trial 1' },
    { id: '4', firstName: 'Selina', lastName: 'Abernathy', email: 'Selina.Abernathy@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '05/04/2024', endDate: '05/09/2024', trial: 'Clinical Trial 2' },
    { id: '5', firstName: 'Lyda', lastName: 'Gulgowski', email: 'Lyda.Gulgowski@domain.ext', status: 'Active', role: 'Site Coord.', startDate: '12/05/2024', endDate: '12/08/2024', trial: 'Clinical Trial 2' },
    { id: '6', firstName: 'Lola', lastName: 'Rutherford', email: 'Lola.Rutherford@domain.ext', status: 'Inactive', role: 'Site Coord.', startDate: '01/06/2024', endDate: '01/07/2024', trial: 'Clinical Trial 2' }
  ]

  const [search, setSearch] = useState('')
  const [trialFilter, setTrialFilter] = useState('')
  const [statusFilter, setStatusFilter] = useState('')
  const [fromDate, setFromDate] = useState<Date | null>(null)
  const [toDate, setToDate] = useState<Date | null>(null)
  const [tempFromDate, setTempFromDate] = useState<Date | null>(null)
  const [tempToDate, setTempToDate] = useState<Date | null>(null)
  const [expandedTrials, setExpandedTrials] = useState<Record<string, boolean>>({ 'Clinical Trial 1': true })
  const [showDropdown, setShowDropdown] = useState<string | null>(null)
  const [showDeleteModal, setShowDeleteModal] = useState<boolean>(false)
  const [userToDelete, setUserToDelete] = useState<UserData | null>(null)
  const [showRemoveModal, setShowRemoveModal] = useState<boolean>(false)
  const [userToRemove, setUserToRemove] = useState<UserData | null>(null)
  const [showRemoveSuccessModal, setShowRemoveSuccessModal] = useState<boolean>(false)
  const [removedUser, setRemovedUser] = useState<UserData | null>(null)
  const [users, setUsers] = useState<UserData[]>(sampleUsers)
  const fromDateRef = useRef<any>(null)
  const toDateRef = useRef<any>(null)

  const trials = [
    { name: 'Clinical Trial 1', count: 50 },
    { name: 'Clinical Trial 2', count: 20 }
  ]

  const filteredUsers = users.filter(user => {
    if (search && !user.firstName.toLowerCase().includes(search.toLowerCase()) &&
        !user.lastName.toLowerCase().includes(search.toLowerCase()) &&
        !user.email.toLowerCase().includes(search.toLowerCase()) &&
        !user.status.toLowerCase().includes(search.toLowerCase()) &&
        !user.role.toLowerCase().includes(search.toLowerCase())) {
      return false
    }

    if (trialFilter && user.trial !== trialFilter) {
      return false
    }

    if (statusFilter && user.status.toLowerCase() !== statusFilter.toLowerCase()) {
      return false
    }

    if (fromDate || toDate) {
      const userStartDate = parseDate(user.startDate)
      if (!userStartDate) return false
      if (fromDate && userStartDate < fromDate) return false
      if (toDate && userStartDate > toDate) return false
    }

    return true
  })

  function parseDate(dateStr: string): Date | null {
    if (!dateStr) return null
    const [day, month, year] = dateStr.split('/').map(Number)
    return new Date(year, month - 1, day)
  }

  const toggleTrial = (trialName: string) => {
    setExpandedTrials(prev => ({
      ...prev,
      [trialName]: !prev[trialName]
    }))
  }

  const getStatusDot = (status: string) => (
    <div className={`w-2 h-2 rounded-full ${status === 'Active' ? 'bg-green-500' : 'bg-red-500'}`}></div>
  )

  const handleUserAction = (user: UserData, event: React.MouseEvent) => {
    event.stopPropagation()
    setShowDropdown(showDropdown === user.id ? null : user.id)
  }

  const handleAddUser = () => {
    console.log('Add User button clicked, navigating to /add-user')
    router.push('/add-user')
  }

  const closeDropdown = () => setShowDropdown(null)

  const handleDeleteUser = (user: UserData) => {
    setUserToDelete(user)
    setShowDeleteModal(true)
    setShowDropdown(null)
  }

  const confirmDeleteUser = () => {
    if (userToDelete) {
      setUsers(users.filter(user => user.id !== userToDelete.id))
      setShowDeleteModal(false)
      setUserToDelete(null)
    }
  }

  const cancelDeleteUser = () => {
    setShowDeleteModal(false)
    setUserToDelete(null)
  }

  const handleRemoveFromTrial = (user: UserData) => {
    setUserToRemove(user)
    setShowRemoveModal(true)
    setShowDropdown(null)
  }

  const confirmRemoveFromTrial = () => {
    if (userToRemove) {
      // Update user status to Inactive
      const updatedUsers = users.map(user => 
        user.id === userToRemove.id 
          ? { ...user, status: 'Inactive' as 'Inactive' }
          : user
      )
      setUsers(updatedUsers)
      
      // Store the removed user data with updated status for success modal
      const updatedUser = { ...userToRemove, status: 'Inactive' as 'Inactive' }
      setRemovedUser(updatedUser)
      
      // Close the confirmation modal
      setShowRemoveModal(false)
      setUserToRemove(null)
      
      // Show success modal
      setShowRemoveSuccessModal(true)
    }
  }

  const cancelRemoveFromTrial = () => {
    setShowRemoveModal(false)
    setUserToRemove(null)
  }

  const closeRemoveSuccessModal = () => {
    setShowRemoveSuccessModal(false)
    setRemovedUser(null)
  }

  const applyDateFilter = () => {
    setFromDate(tempFromDate)
    setToDate(tempToDate)
  }

  return (
    <div className="min-h-screen bg-white py-4">
      <div className="max-w-5xl mx-auto px-4 mt-8">
        <div className="bg-white rounded-2xl shadow-sm">
          {/* Header */}
          <div className="px-5 py-3 border-b bg-gray-100 border-gray-200 flex justify-between items-center rounded-t-2xl">
            <h1 className="text-lg text-gray-900">Users</h1>
            <div className="flex items-center space-x-3">
              <div className="relative">
                <input
                  type="text"
                  placeholder="Search"
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  className="w-70 pl-8 pr-20 px-2 py-2 border border-gray-300 rounded-3xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <Search className="absolute left-2 top-1/2 transform -translate-y-1/2 h-3 w-3 text-gray-400" />
              </div>
              <button
                onClick={handleAddUser}
                className="bg-[#007fb2] text-white px-3 py-2 rounded-3xl text-sm font-medium flex items-center space-x-1 hover:bg-blue-700"
              >
                <Plus className="h-3 w-3" />
                <span>Add User</span>
              </button>
            </div>
          </div>

          {/* Filters */}
          <div className="px-4 py-3 border-b border-gray-200 flex flex-wrap gap-3 items-center text-sm">
            <span className="font-medium text-gray-700">FILTER</span>
            <select 
              value={trialFilter} 
              onChange={(e) => setTrialFilter(e.target.value)} 
              className="px-2 py-1 h-9 border bg-gray-100 border-gray-300 rounded-md text-sm"
            >
              <option value="">Trial Name</option>
              <option value="Clinical Trial 1">Clinical Trial 1</option>
              <option value="Clinical Trial 2">Clinical Trial 2</option>
            </select>
            <select 
              value={statusFilter} 
              onChange={(e) => setStatusFilter(e.target.value)} 
              className="px-2 py-1 h-9 bg-gray-100 border border-gray-300 rounded-md text-sm"
            >
              <option value="">Status</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>

            {/* Date Filter */}
            <div className="flex items-center gap-2">
              <span className="font-medium text-gray-700 text-sm">DATE</span>
              <div className="flex items-center bg-white border border-gray-300 rounded-lg h-9">
                {/* From Date */}
                <div className="relative flex items-center px-2 hover:bg-gray-50 rounded-l-lg">
                  <DatePicker
                    ref={fromDateRef}
                    selected={tempFromDate}
                    onChange={(date) => setTempFromDate(date)}
                    placeholderText="From"
                    
                    dateFormat="dd/MM/yyyy"
                    wrapperClassName="date-picker-wrapper"
                    popperClassName="date-picker-high-z-index"
                    popperPlacement="bottom-start"
                  />
                  <Calendar 
                    className="h-3 w-3 text-gray-500 ml-1 h-full cursor-pointer" 
                    onClick={() => fromDateRef.current?.setFocus()}
                  />
                </div>
                
                {/* Divider */}
                <div className="h-5 w-px bg-gray-300"></div>
                
                {/* To Date */}
                <div className="relative flex items-center px-2 hover:bg-gray-50">
                  <DatePicker
                    ref={toDateRef}
                    selected={tempToDate}
                    onChange={(date) => setTempToDate(date)}
                    placeholderText="To"
                    dateFormat="dd/MM/yyyy"
                    wrapperClassName="date-picker-wrapper"
                    popperClassName="date-picker-high-z-index"
                    popperPlacement="bottom-start"
                  />
                  <Calendar 
                    className="h-3 w-3 text-gray-500 ml-1 cursor-pointer" 
                    onClick={() => toDateRef.current?.setFocus()}
                  />
                </div>
                
                {/* Apply Button - Integrated */}
                <button 
                  className="bg-gray-500 hover:bg-gray-600 text-white px-2 h-full transition-colors flex items-center justify-center rounded-r-lg"
                  onClick={applyDateFilter}
                >
                  <ArrowRight className="h-3 w-3" />
                </button>
              </div>
            </div>

            {(trialFilter || statusFilter || fromDate || toDate) && (
              <button 
                onClick={() => { 
                  setTrialFilter(''); 
                  setStatusFilter(''); 
                  setFromDate(null); 
                  setToDate(null); 
                  setTempFromDate(null); 
                  setTempToDate(null);
                }} 
                className="text-gray-400 hover:text-gray-600"
              >
                <X className="h-3 w-3" />
              </button>
            )}
          </div>

          {/* Trials Section */}
          {trials.map(trial => {
            const trialUsers = filteredUsers.filter(user => user.trial === trial.name)
            return (
              <div key={trial.name} className="border-b border-gray-200 last:border-b-0">
                <div className="px-4 py-3 bg-gray-50 flex justify-between items-center">
                  <button 
                    onClick={() => toggleTrial(trial.name)} 
                    className="flex items-center space-x-2"
                  >
                    <ChevronDown className={`h-4 w-4 transition-transform ${expandedTrials[trial.name] ? 'rotate-180' : ''}`} />
                    <span className="font-medium text-gray-900 text-sm">{trial.name}</span>
                  </button>
                  <span className="text-xs text-gray-500">{trialUsers.length} Records</span>
                </div>
                {expandedTrials[trial.name] && (
                  <div className="overflow-x-auto">
                    <table className="min-w-full divide-y divide-gray-200">
                      <thead className="bg-gray-50">
                        <tr>
                          {['First name', 'Last name', 'Email', 'Status', 'Role', 'Start date', 'End date', 'Actions'].map(header => (
                            <th key={header} className="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody className="bg-white divide-y divide-gray-200">
                        {trialUsers.map(user => (
                          <tr key={user.id} className="hover:bg-gray-50">
                          <td className="px-3 py-2 text-sm">{user.firstName}</td>
                          <td className="px-3 py-2 text-sm">{user.lastName}</td>
                          <td className="px-3 py-2 text-sm">{user.email}</td>
                          <td className="px-3 py-2 flex items-center space-x-1">
                            {getStatusDot(user.status)}
                            <span className="text-xs">{user.status}</span>
                          </td>
                          <td className="px-3 py-2 text-sm">{user.role}</td>
                          <td className="px-3 py-2 text-sm">{user.startDate}</td>
                          <td className="px-3 py-2 text-sm">{user.endDate || '-'}</td>
                          <td className="px-3 py-2 relative">
                            <button 
                              onClick={(e) => handleUserAction(user, e)} 
                              className="p-1 hover:bg-gray-100 rounded"
                            >
                              <MoreVertical className="h-3 w-3 text-gray-400" />
                            </button>
                            {showDropdown === user.id && (
                                <div className="absolute right-0 mt-1 w-32 bg-white rounded-md shadow-lg z-10 border text-xs">
                                  <a href="/edit-user" className="block px-3 py-1 text-gray-700 hover:bg-gray-100">Edit</a>
                                  <button 
                                    onClick={() => handleRemoveFromTrial(user)}
                                    className="block w-full text-left px-3 py-1 text-gray-700 hover:bg-gray-100"
                                  >
                                    Remove from trial
                                  </button>
                                  <button 
                                    onClick={() => handleDeleteUser(user)}
                                    className="block w-full text-left px-3 py-1 text-red-600 hover:bg-gray-100"
                                  >
                                    Delete
                                  </button>
                                </div>
                            )}
                          </td>
                        </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            )
          })}

          {/* No Results */}
          {filteredUsers.length === 0 && (
            <div className="text-center py-8">
              <div className="text-gray-500 text-sm">No users found matching your criteria</div>
            </div>
          )}
        </div>
      </div>

      {/* Delete Confirmation Modal */}
      {showDeleteModal && userToDelete && (
        <div className="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4">
            {/* Modal Header */}
            <div className="flex items-center justify-between p-4 border-b border-gray-200">
              <h2 className="text-lg font-semibold text-gray-900">Delete User</h2>
              <button
                onClick={cancelDeleteUser}
                className="p-2 hover:bg-gray-100 rounded-full transition-colors"
              >
                <X className="h-5 w-5 text-gray-600" />
              </button>
            </div>

            {/* Modal Content */}
            <div className="p-6">
              {/* Warning Section */}
              <div className="flex items-start space-x-4 mb-6">
                {/* Warning Icon */}
                <div className="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                  <span className="text-red-600 text-xl font-bold">!</span>
                </div>
                
                {/* Warning Text */}
                <div className="flex-1">
                  <h3 className="text-md font-semibold text-gray-900 mb-1">
                    Are you sure you want to delete this user?
                  </h3>
                  <p className="text-md font-semibold text-gray-900">
                    This action can not be undone.
                  </p>
                </div>
              </div>

              {/* Divider */}
              <div className="border-t border-gray-200 mb-6"></div>

              {/* User Details */}
              <div className="grid grid-cols-2 gap-4 mb-6">
                {/* Left Column - User Info */}
                <div>
                  <div className="font-semibold text-gray-900 text-sm mb-1">
                    {userToDelete.firstName} {userToDelete.lastName}
                  </div>
                  <div className="text-xs text-gray-600">
                    {userToDelete.email}
                  </div>
                </div>

                {/* Right Column - Role and Trials */}
                <div>
                  <div className="font-semibold text-gray-900 text-sm mb-1">
                    {userToDelete.role}
                  </div>
                  <div className="text-xs text-gray-600 space-y-1">
                    <div>Repudiandae assumenda</div>
                    <div>Tenetur non et</div>
                    <div>Eos qui reiciendis</div>
                  </div>
                </div>
              </div>

              {/* Action Buttons */}
              <div className="flex justify-end space-x-3">
                <button
                  onClick={cancelDeleteUser}
                  className="flex items-center space-x-2 px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors"
                >
                  <span>Cancel</span>
                  <X className="h-4 w-4" />
                </button>
                <button
                  onClick={confirmDeleteUser}
                  className="flex items-center space-x-2 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
                >
                  <span>Delete User</span>
                  <svg className="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Remove from Trial Confirmation Modal */}
      {showRemoveModal && userToRemove && (
        <div className="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4">
            {/* Modal Header */}
            <div className="flex items-center justify-between p-4 border-b border-gray-200">
              <h2 className="text-lg font-semibold text-gray-900">Remove from Trial</h2>
              <button
                onClick={cancelRemoveFromTrial}
                className="p-2 hover:bg-gray-100 rounded-full transition-colors"
              >
                <X className="h-5 w-5 text-gray-600" />
              </button>
            </div>

            {/* Modal Content */}
            <div className="p-6">
              {/* Info Icon */}
              <div className="flex items-center justify-center mb-4">
                <div className="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg className="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>

              {/* Confirmation Message */}
              <div className="text-center mb-6">
                <h3 className="text-lg font-medium text-gray-900 mb-2">Remove from Clinical Trial?</h3>
                <p className="text-sm text-gray-600">
                  This will remove the user from the current clinical trial but keep them in the system.
                </p>
                <div className="mt-3 p-3 bg-gray-50 rounded-lg">
                  <p className="text-sm font-medium text-gray-900">
                    {userToRemove.firstName} {userToRemove.lastName}
                  </p>
                  <p className="text-xs text-gray-600">{userToRemove.email}</p>
                  <p className="text-xs text-gray-500 mt-1">Current Trial: Clinical Trial 1</p>
                </div>
              </div>

              {/* Action Buttons */}
              <div className="flex space-x-3">
                <button
                  onClick={cancelRemoveFromTrial}
                  className="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
                >
                  Cancel
                </button>
                <button
                  onClick={confirmRemoveFromTrial}
                  className="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                >
                  Remove from Trial
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Remove from Trial Success Modal */}
      {showRemoveSuccessModal && removedUser && (
        <div className="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4">
            {/* Modal Header */}
            <div className="flex items-center justify-between p-4 border-b border-gray-200">
              <h2 className="text-lg font-semibold text-gray-900">Remove from Trial</h2>
              <button
                onClick={closeRemoveSuccessModal}
                className="p-2 hover:bg-gray-100 rounded-full transition-colors"
              >
                <X className="h-5 w-5 text-gray-600" />
              </button>
            </div>

            {/* Success Content */}
            <div className="p-6">
              {/* Success Message */}
              <div className="text-center mb-6">
                <div className="flex items-center justify-center mb-3">
                  <div className="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                    <svg className="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </div>
                <h3 className="text-lg font-medium text-gray-900">User removed from trial</h3>
              </div>

              {/* Divider */}
              <div className="border-t border-gray-200 mb-6"></div>

              {/* User Details */}
              <div className="grid grid-cols-2 gap-4 mb-6">
                {/* Left Column - User Info */}
                <div>
                  <div className="font-semibold text-gray-900 text-sm mb-1">
                    {removedUser.firstName} {removedUser.lastName}
                  </div>
                  <div className="text-xs text-gray-600">
                    {removedUser.email}
                  </div>
                </div>

                {/* Right Column - Trial Info */}
                <div>
                  <div className="font-semibold text-gray-900 text-sm mb-1">
                    Removed from
                  </div>
                  <div className="text-xs text-gray-600">
                    Clinical Trial 1
                  </div>
                </div>
              </div>

              {/* Close Button */}
              <div className="flex justify-end">
                <button
                  onClick={closeRemoveSuccessModal}
                  className="flex items-center space-x-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                >
                  <span>Close</span>
                  <X className="h-4 w-4" />
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
